{
  // Project-local OpenCode config — copy via agentic-dev, not global ~/.config/opencode
  // Improvement: project reads global first, then overrides here. This file is project truth.
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    // Default auto-approve for routine, denials still apply
    "default": "ask",
    "allow": [
      "read:*",
      "edit:*",
      "bash:pnpm *",
      "bash:npm *",
      "bash:node *",
      "bash:git status*",
      "bash:git diff*",
      "bash:git log*"
    ],
    "deny": [
      "read:.env",
      "read:.env.*",
      "read:**/.env",
      "bash:git push*",
      "bash:npm publish*",
      "bash:rm -rf /*",
      "bash:rm -rf ~*"
    ]
  },
  "agents": {
    // Model routing: use cheap tier for volume, expensive only for architecture/security review.
    // Set a per-agent "model" via /models using YOUR account's IDs. Do NOT hardcode real
    // model IDs in this public repo. Example:
    //   "planner": { "model": "your-provider/your-model", "permission": { "edit": "deny" } }
    "planner": { "permission": { "edit": "deny" } },
    "test-author": { "permission": { "edit": "allow" } },
    "implementer": {},
    "reviewer": { "permission": { "edit": "deny" } },
    "verifier": { "permission": { "edit": "deny" } },
    "debugger": {}
  },
  "instructions": [
    "AGENTS.md",
    "docs/architecture.md",
    "docs/quality-gates.md"
  ]
}
