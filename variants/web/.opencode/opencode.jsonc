{
  // Project-local OpenCode config — copy via agentic-dev, not global ~/.config/opencode
  // Improvement: project reads global first, then overrides here. This file is project truth.
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    // Default auto-approve for routine, denials still apply
    "default": "ask",
    "allow": [
      "read:*",
      "edit:*",
      "bash:pnpm *",
      "bash:npm *",
      "bash:node *",
      "bash:git status*",
      "bash:git diff*",
      "bash:git log*"
    ],
    "deny": [
      "read:.env",
      "read:.env.*",
      "read:**/.env",
      "bash:git push*",
      "bash:npm publish*",
      "bash:rm -rf /*",
      "bash:rm -rf ~*"
    ]
  },
  "agents": {
    // Model routing: use cheap tier for volume, expensive only for architecture/security review
    // Set via /models; example ids below are placeholders — replace with your account's exposed IDs
    "planner": { "model": "your-smol-model", "permission": { "edit": "deny" } },
    "test-author": { "model": "your-smol-model", "permission": { "edit": "allow" } },
    "implementer": { "model": "your-smol-model" },
    "reviewer": { "model": "your-default-model", "permission": { "edit": "deny" } },
    "verifier": { "model": "your-smol-model", "permission": { "edit": "deny" } },
    "debugger": { "model": "your-smol-model" }
  },
  "instructions": [
    "AGENTS.md",
    "docs/architecture.md",
    "docs/quality-gates.md"
  ]
}
